#!/bin/sh

set -eu

commit_msg_file="$1"

# Kleurcodes voor de terminal (ANSI escape codes)
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

awk -v red="$RED" -v green="$GREEN" -v yellow="$YELLOW" -v nc="$NC" '
BEGIN {
  valid = 1
}

NR == 1 {
  header = $0

  if (length(header) > 100) {
    print red "     ❌ FOUT: Je commit-header is te lang (" length(header) " tekens)." nc
    print yellow "  Maximum toegestaan is 100 tekens." nc
    valid = 0
  }

  if (header !~ /^(feat|fix|docs|style|refactor|test|chore)(\([^()]+\))?: /) {
    print red "     ❌ FOUT: Ongeldig formaat voor je commit-header." nc
    print green "   👉 Gebruik het formaat: type(scope): onderwerp  of  type: onderwerp" nc
    print yellow "  Geldige types zijn: feat, fix, docs, style, refactor, test, chore" nc
    valid = 0
  } else {
    subject = header
    sub(/^[^:]+: /, "", subject)

    if (length(subject) == 0) {
      print red "❌ FOUT: Het onderwerp (subject) ontbreekt." nc
      valid = 0
    }

    if (subject ~ /\.$/) {
      print red "   ❌ FOUT: Het onderwerp mag niet eindigen met een punt." nc
      valid = 0
    }
  }
}

NR == 2 && length($0) != 0 {
  print red "❌ FOUT: Er ontbreekt een lege regel tussen de header en de body." nc
  valid = 0
}

{
  lines[NR] = $0
}

END {
  for (i = 2; i <= NR; i++) {
    if (lines[i] ~ /^(BREAKING CHANGE:|Closes #|Fixes #|Resolves #)/) {
      if (i > 1 && length(lines[i - 1]) != 0) {
        print red "❌ FOUT: Er moet een lege regel voorafgaan aan de footer (" lines[i] ")." nc
        valid = 0
      }
    }
  }

  if (!valid) {
    print ""
    print red "--------------------------------------------------------"
    print "❌ Commit afgekeurd! Pas je commit-bericht aan en probeer opnieuw."
    print "--------------------------------------------------------" + nc
    exit 1
  }
}
' "$commit_msg_file"