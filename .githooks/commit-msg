#!/bin/sh

set -eu

commit_msg_file="$1"

# Terminal color codes (ANSI escape codes)
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

awk -v red="$RED" -v green="$GREEN" -v yellow="$YELLOW" -v nc="$NC" '
BEGIN {
  has_error = 0
}

NR == 1 {
  header = $0

  if (length(header) > 100) {
    print red "❌ ERROR: Your commit header is too long (" length(header) " characters)." nc
    print yellow "   Maximum allowed is 100 characters." nc
    has_error = 1
  }

  if (header !~ /^(feat|fix|docs|style|refactor|test|chore)(\([^()]+\))?: /) {
    print red "❌ ERROR: Invalid format for your commit header." nc
    print green "👉 Use format: type: description or type(scope): description" nc
    print yellow "Valid types are: feat, fix, docs, style, refactor, test, chore" nc
    has_error = 1
  }

  sub(/^[^:]+: /, "", header)
  
  if (header != $0) {
    subject = header
    
    if (length(subject) == 0) {
      print red "❌ ERROR: The subject is missing." nc
      has_error = 1
    }

    if (subject ~ /\.$/) {
      print red "❌ ERROR: The subject must not end with a period." nc
      has_error = 1
    }
  }
}

NR == 2 && length($0) != 0 {
  print red "❌ ERROR: A blank line is missing between the header and the body." nc
  has_error = 1
}

{
  lines[NR] = $0
}

END {
  for (i = 2; i <= NR; i++) {
    if (lines[i] ~ /^(BREAKING CHANGE:|Closes #|Fixes #|Resolves #)/) {
      if (i > 1 && length(lines[i - 1]) != 0) {
        print red "❌ ERROR: A blank line must precede the footer (" lines[i] ")." nc
        has_error = 1
      }
    }
  }

  if (has_error) {
    print ""
    print red "--------------------------------------------------------"
    print "❌ Commit rejected! Please fix your commit message and try again."
    print "--------------------------------------------------------" nc
    exit 1
  }
}
' "$commit_msg_file"