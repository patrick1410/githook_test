#!/bin/sh

commit_msg_file="$1"

# Terminal color codes (ANSI escape codes)
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'

awk -v red="$RED" -v green="$GREEN" -v yellow="$YELLOW" '
BEGIN {
  has_error = 0
}

NR == 1 {
  header = $0

  # 1. Check lengte (max 100 tekens)
  if (length(header) > 100) {
    print red "❌ ERROR: Header is too long (" length(header) " characters)."
    print yellow "   Maximum allowed is 100 characters."
    has_error = 1
  }

  # 2. Check of het onderwerp volledig ontbreekt
  if (header ~ /^[a-zA-Z]+(\([^()]+\))?:[[:space:]]*$/) {
    print red "❌ ERROR: Subject is missing."
    has_error = 1
  }

  # 3. Check of de spatie direct na de dubbele punt ontbreekt
  else if (header ~ /^[a-zA-Z]+(\([^()]+\))?:[^[:space:]]/) {
    print red "❌ ERROR: Missing space after the colon."
    print yellow "   Use format: type: subject or type(scope): subject"
    has_error = 1
  }

  # 4. Check of het type geldig is
  if (header !~ /^(feat|fix|docs|style|refactor|test|chore)(\([^()]+\))?:/) {
    print red "❌ ERROR: Invalid format. Use: type: subject or type(scope): subject"
    print yellow "Valid types are: feat, fix, docs, style, refactor, test, chore"
    has_error = 1
  }

  # 5. Check of het onderwerp eindigt op een punt
  if (header ~ /\.$/) {
    print red "❌ ERROR: Subject must not end with a period."
    has_error = 1
  }
}

# Blokkeer multi-line commits
NR > 1 {
  if (!multi_line_reported) {
    print red "❌ ERROR: Multi-line commit messages are not allowed."
    has_error = 1
    multi_line_reported = 1
  }
}

END {
  if (has_error) {
    print ""
    print red "--------------------------------------------------------"
    print "❌ Commit rejected! Please fix your commit message."
    print "--------------------------------------------------------"
    exit 1
  } else {
    print green "✔ Commit message successfully validated!"
  }
}
' "$commit_msg_file"

