#!/bin/sh

commit_msg_file="$1"

# Terminal color codes (ANSI escape codes)
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'

awk -v red="$RED" -v green="$GREEN" -v yellow="$YELLOW" '
BEGIN {
  has_error = 0
}

NR == 1 {
  header = $0

  if (length(header) > 100) {
    print red "❌ ERROR: Header is too long (" length(header) " characters)."
    print yellow "   Maximum allowed is 100 characters."
    has_error = 1
  }

  if (header ~ /^(feat|fix|docs|style|refactor|test|chore)(\([^()]+\))?:[^\s]/) {
    print red "❌ ERROR: Missing space after the colon."
    print yellow "   Use format: type: subject or type(scope): subject"
    has_error = 1
  }
  else if (header !~ /^(feat|fix|docs|style|refactor|test|chore)(\([^()]+\))?: /) {
    print red "❌ ERROR: Invalid format. Use: type: subject or type(scope): subject"
    print yellow "Valid types are: feat, fix, docs, style, refactor, test, chore"
    has_error = 1
  } else {
    subject = header
    sub(/^[^:]+: /, "", subject)

    if (length(subject) == 0) {
      print red "❌ ERROR: Subject is missing."
      has_error = 1
    }

    if (subject ~ /\.$/) {
      print red "❌ ERROR: Subject must not end with a period."
      has_error = 1
    }
  }
}

NR > 1 {
  print red "❌ ERROR: Multi-line commit messages are not allowed."
  has_error = 1
}

END {
  if (has_error) {
    print ""
    print red "--------------------------------------------------------"
    print "❌ Commit rejected! Please fix your commit message."
    print "--------------------------------------------------------"
    exit 1
  }
}
' "$commit_msg_file"